{
  "name": "openkey",
  "version": "3.0.1",
  "description": "This is a shoutkey.com replica",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "test": "NODE_ENV=test jest ./src/tests --config ./jest.config.ts",
    "migrate-generate": "drizzle-kit generate",
    "migrate-up": "drizzle-kit migrate",
    "migrate-down": "drizzle-kit drop",
    "db:launch": "docker run --name openkey-database -p 5432:5432 -e POSTGRES_PASSWORD=password -d postgres",
    "db:restart": "docker restart openkey-database",
    "db:destroy": "docker rm openkey-database",
    "db:stop": "docker stop openkey-database",
    "docker-build": "docker build . -p 3000:3000 -f ./Dockerfile -t openkey-app:latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreGarvin/openkey.git"
  },
  "author": "Andre Garvin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andreGarvin/openkey/issues"
  },
  "homepage": "https://github.com/andreGarvin/openkey#readme",
  "devDependencies": {
    "@babel/core": "7.4.0",
    "@babel/preset-env": "7.4.2",
    "@babel/preset-react": "7.0.0",
    "@types/date-fns": "2.6.0",
    "@types/node": "22.13.5",
    "@types/node-fetch": "2.5.7",
    "@types/react": "19.0.10",
    "@types/winston": "2.4.4",
    "babel-cli": "6.26.0",
    "babel-core": "6.26.3",
    "babel-loader": "8.0.5",
    "css-loader": "2.1.0",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.30.2",
    "mini-css-extract-plugin": "0.5.0",
    "postcss": "8.5.3",
    "prettier": "2.8.6",
    "sass": "1.30.0",
    "sass-loader": "10.1.0",
    "style-loader": "0.23.1",
    "ts-node": "9.1.1",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "date-fns": "2.16.1",
    "drizzle-orm": "0.38.4",
    "helmet": "4.2.0",
    "next": "14.2.24",
    "node-fetch": "2.6.1",
    "pg": "8.13.1",
    "postgres": "3.4.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-is": "19.1.1",
    "reflect-metadata": "^0.1.10",
    "styled-components": "5.2.1",
    "uuid": "11.0.5",
    "winston": "3.3.3"
  }
}
